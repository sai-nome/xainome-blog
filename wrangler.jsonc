{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "xainome-blog",
  "compatibility_date": "2026-09-03",
  "build": {
    "command": "npm run build"
  },
  "assets": {
    "directory": "./public",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "workers_dev": true,
  "preview_urls": true
}
